# Copy this file to .env and fill in your values. NEVER commit .env.
#
# --- AI provider (Gemini) ---
# Optional. If empty/missing, the system falls back to offline
# heuristic classifier + template negotiator so the demo still runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Creator profile used by the seed script ---
CREATOR_NAME=Maya Chen
CREATOR_MIN_RATE=500
CREATOR_NICHE=Tech & Lifestyle
CREATOR_TONE=friendly, professional, concise
CREATOR_EXCLUSIONS=no gambling, no crypto
CREATOR_INSTAGRAM_ID=ig_creator_maya
CREATOR_PHONE=whatsapp:+15551234567

# --- Mock integration toggles ---
# When true, the backend uses the built-in simulator instead of real
# Meta Graph API / Twilio calls. Set to false when wiring real creds.
MOCK_INTEGRATIONS=true

# --- Meta / Instagram (real mode) ---
IG_GRAPH_TOKEN=
IG_GRAPH_API=https://graph.facebook.com/v19.0

# --- Twilio WhatsApp (real mode) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Webhook verification token (Meta handshake) ---
WEBHOOK_VERIFY_TOKEN=creatoros-verify-123

# --- Runtime ---
DATABASE_PATH=./data/creatoros.db
HOST=0.0.0.0
PORT=8000
